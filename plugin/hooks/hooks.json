{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/milepost",
            "timeout": 30,
            "args": [
              "hook",
              "session-start"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/milepost",
            "timeout": 30,
            "args": [
              "hook",
              "post-edit"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/milepost",
            "timeout": 60,
            "args": [
              "hook",
              "stop"
            ]
          }
        ]
      }
    ]
  }
}
