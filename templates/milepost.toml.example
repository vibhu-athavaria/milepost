# milepost configuration. Commit this file.
# Generated by `milepost init`; edit module entries to match your repository.

[project]
name = "my-project"
kb_dir = "kb"

# One table per module. The id must match [a-z0-9][a-z0-9_-]*.
# Each module gets one L2 note at kb/modules/<id>.md.
#
# [modules.services]
# title = "Services"
# sources = ["app/services/**/*.py"]
# related = ["ai"]
# Commands that check this module. Written by a person; agents get them from kb_module and kb_sync.
# verify = ["pytest backend/app/tests/services"]

[structure]
languages = ["python", "typescript"]
ignore = ["**/node_modules/**", "**/__pycache__/**", "**/.venv/**", "**/dist/**"]
# Where module candidates live. Used by init, scan, and the uncovered-directory check.
roots = ["src", "app", "backend/app", "packages", "apps"]

[index]
backend = "sqlite"
path = "kb/.index/index.sqlite"
# Name of a fastembed model. Choose one and keep embedding_dim in step with it.
embedding_model = "BAAI/bge-small-en-v1.5"
embedding_dim = 384

[draft]
# "model": milepost calls the model named by MILEPOST_MODEL to draft notes (needs a provider key).
# "agent": milepost calls no model; your coding agent drafts through kb_draft_module.
mode = "model"
# Resolved from the MILEPOST_MODEL environment variable at run time. Never put a model name here.
# Also set the provider's own key variable (OPENROUTER_API_KEY, ANTHROPIC_API_KEY, ...).
# Both can live in a git-ignored .env file at the repo root; see templates/.env.example.
# `milepost doctor` reports what is missing.
provider_model = "${MILEPOST_MODEL}"
max_source_bytes = 200000
exclude = ["**/.env*", "**/*secret*", "**/*.pem", "**/*.key", "**/credentials*"]

[check]
# "stale" fails on stale notes (default). "none" reports only.
fail_on = "stale"
# Warn when L3 plus L4 notes exceed this count. A placeholder; tune it in the pilot.
max_detail_notes = 50

[visibility]
# Regexes matched against commit messages to count agent-authored commits in `milepost status`.
agent_trailers = ["Co-Authored-By: Claude", "Generated with"]
# Warn (never fail) when a reviewed note's sources changed by more than this many lines since review.
churn_warn_lines = 1000
