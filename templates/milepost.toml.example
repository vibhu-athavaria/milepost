# milepost configuration. Commit this file.
# Generated by `milepost init`; edit module entries to match your repository.

[project]
name = "my-project"
kb_dir = "kb"

# One table per module. The id must match [a-z0-9][a-z0-9_-]*.
# Each module gets one L2 note at kb/modules/<id>.md.
#
# [modules.services]
# title = "Services"
# sources = ["app/services/**/*.py"]
# related = ["ai"]
# Commands that check this module. Written by a person; agents get them from kb_module and kb_sync.
# verify = ["pytest backend/app/tests/services"]

[structure]
languages = ["python", "typescript"]
ignore = ["**/node_modules/**", "**/__pycache__/**", "**/.venv/**", "**/dist/**"]
# Where module candidates live. Used by init, scan, and the uncovered-directory check.
roots = ["src", "app", "backend/app", "packages", "apps"]

[index]
backend = "sqlite"
path = "kb/.index/index.sqlite"
# Name of a fastembed model. Choose one and keep embedding_dim in step with it.
embedding_model = "BAAI/bge-small-en-v1.5"
embedding_dim = 384

[draft]
# Claude writes the notes through kb_draft_module and kb_update; there is no model to configure.
max_source_bytes = 60000
exclude = ["**/.env*", "**/*secret*", "**/*.pem", "**/*.key", "**/credentials*"]
# Files the credential scan withholds (false positives such as token-type constants) that a
# person has checked and wants included in drafting:
secret_scan_allow = []

[check]
# "stale" (default): errors such as an invalid note fail the check. "none": report only.
fail_on = "stale"
# "warn" (default): a note whose code changed after the note was last updated is reported but
# never fails. "fail": a pull request that edits covered code without touching its note fails.
stale = "warn"

[visibility]
# Regexes matched against commit messages to count agent-authored commits in `milepost status`.
agent_trailers = ["(?im)^Co-Authored-By:.*noreply@anthropic\\.com", "Generated with \\[?Claude Code"]
# `milepost check` warns (never fails) when a reviewed note's sources changed by more than this
# many lines since the note was last reviewed.
churn_warn_lines = 1000
