# Copy to .env at the repository root. milepost loads it for draft, init, doctor and serve.
# A variable already set in your shell wins. .env is git-ignored by `milepost init`; never commit it.

# LiteLLM model name. For OpenRouter use the openrouter/ prefix plus OpenRouter's model slug.
MILEPOST_MODEL=openrouter/anthropic/claude-sonnet-4.5

# The provider's own key variable (OpenRouter shown; ANTHROPIC_API_KEY for an Anthropic model).
OPENROUTER_API_KEY=
